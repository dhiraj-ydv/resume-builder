{
  "name": "resume-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Downloadable local resume builder with desktop, browser, CLI, and MCP access.",
  "license": "MIT",
  "author": "Resume Builder contributors",
  "keywords": [
    "resume",
    "cv",
    "local-first",
    "tauri",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exolithelabs/resume-builder.git"
  },
  "homepage": "https://github.com/exolithelabs/resume-builder#readme",
  "bugs": {
    "url": "https://github.com/exolithelabs/resume-builder/issues"
  },
  "bin": {
    "resume-builder": "./bin/resume-builder.mjs"
  },
  "files": [
    "bin",
    "src",
    "web",
    "templates",
    "skills",
    "desktop",
    "readme.md",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node --test",
    "start": "node bin/resume-builder.mjs",
    "serve": "node bin/resume-builder.mjs serve --browser",
    "desktop": "node bin/resume-builder.mjs desktop",
    "desktop:prepare": "node scripts/prepare-desktop-sidecar.mjs",
    "tauri": "tauri",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:build": "npm run desktop:prepare && tauri build",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs --set",
    "resume-builder": "node bin/resume-builder.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "marked": "^15.0.12",
    "playwright": "^1.55.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.5"
  }
}
